                // --- neutral objects near a point that hud_Clear will remove (Xel&apos;Naga towers, rocks, critters...; never minerals / geysers)
                unitgroup lib439EC7DD_hud_Neutrals (point c, fixed r) {
                    unitgroup g;
                    unitgroup res;
                    int i;
                    int n;
                    int o;
                    unit u;
                    res = UnitGroupEmpty();
                    g = UnitGroup(null, c_playerAny, RegionCircle(c, r), null, 0);
                    n = UnitGroupCount(g, c_unitCountAll);
                    i = 1;
                    while (i &lt;= n) {
                        u = UnitGroupUnit(g, i);
                        o = UnitGetOwner(u);
                        if ((o == 0 || o == 15) &amp;&amp; !UnitFilterMatch(u, o, UnitFilter((1 &lt;&lt; c_targetFilterRawResource), 0, 0, 0))) { UnitGroupAdd(res, u); }
                        i = i + 1;
                    }
                    return res;
                }
                // true if an unwalkable point is only blocked by one of those removable objects
                bool lib439EC7DD_hud_Removable (point p, unitgroup ng) {
                    int i;
                    int n;
                    unit u;
                    n = UnitGroupCount(ng, c_unitCountAll);
                    i = 1;
                    while (i &lt;= n) {
                        u = UnitGroupUnit(ng, i);
                        if (DistanceBetweenPoints(p, UnitGetPosition(u)) &lt;= UnitGetPropertyFixed(u, c_unitPropRadius, c_unitPropCurrent) + 1.0) { return true; }
                        i = i + 1;
                    }
                    return false;
                }
                // --- pick a spot for the red circle: whole circle on one cliff level, height spread &lt; 0.4, no hiding grass (shrubs),
                // every half cell walkable - except where only a removable neutral object (tower, rocks) stands
                bool lib439EC7DD_hud_IsFlat (point c, fixed r) {
                    int a;
                    int i;
                    int j;
                    int k;
                    fixed h0;
                    fixed h;
                    point q;
                    int lvl;
                    unitgroup ng;
                    h0 = WorldHeight(c_heightMapGround, c);
                    lvl = CliffLevel(c);
                    a = 0;
                    while (a &lt; 16) {
                        q = PointWithOffsetPolar(c, r, IntToFixed(a) * 22.5);
                        if (CliffLevel(q) != lvl) { return false; }
                        h = WorldHeight(c_heightMapGround, q);
                        if (AbsF(h - h0) &gt; 0.4) { return false; }
                        q = PointWithOffsetPolar(c, r * 0.5, IntToFixed(a) * 22.5);
                        if (CliffLevel(q) != lvl) { return false; }
                        h = WorldHeight(c_heightMapGround, q);
                        if (AbsF(h - h0) &gt; 0.4) { return false; }
                        a = a + 1;
                    }
                    ng = null;
                    k = FixedToInt(r * 2.0);
                    i = -k;
                    while (i &lt;= k) {
                        j = -k;
                        while (j &lt;= k) {
                            if (i * i + j * j &lt;= k * k) {
                                q = PointWithOffset(c, IntToFixed(i) * 0.5, IntToFixed(j) * 0.5);
                                if (InShrub(q)) { return false; }
                                if (PointPathingPassable(q) == false) { if (ng == null) { ng = lib439EC7DD_hud_Neutrals(c, r + 3.0); } if (!lib439EC7DD_hud_Removable(q, ng)) { return false; } }
                            }
                            j = j + 1;
                        }
                        i = i + 1;
                    }
                    return true;
                }
