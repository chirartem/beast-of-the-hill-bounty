// a real participant: playing, human or AI, and owns units (observers / referees own nothing)
bool lib439EC7DD_hud_IsReal (int p) {
    if (PlayerStatus(p) != c_playerStatusActive) { return false; }
    if (PlayerType(p) != c_playerTypeUser && PlayerType(p) != c_playerTypeComputer) { return false; }
    return (UnitGroupCount(UnitGroup(null, p, RegionEntireMap(), null, 0), c_unitCountAll) > 0);
}
// called from the BountyOnDeath trigger after a bounty is paid
void lib439EC7DD_hud_AddBounty (int p, int m, int g) {
    if (p < 1 || p > 15) { return; }
    lib439EC7DD_hud_bM[p] = lib439EC7DD_hud_bM[p] + m;
    lib439EC7DD_hud_bG[p] = lib439EC7DD_hud_bG[p] + g;
    lib439EC7DD_hud_bDirty = true;
}
// re-sort the bounty table: most earned (minerals + gas) first
void lib439EC7DD_hud_BountyRefresh () {
    text t;
    text v;
    int i;
    int j;
    int k;
    int a;
    int b;
    int p;
    i = 0;
    while (i < lib439EC7DD_hud_bRows) {
        j = i + 1;
        while (j < lib439EC7DD_hud_bRows) {
            a = lib439EC7DD_hud_bList[i];
            b = lib439EC7DD_hud_bList[j];
            if (lib439EC7DD_hud_bM[b] + lib439EC7DD_hud_bG[b] > lib439EC7DD_hud_bM[a] + lib439EC7DD_hud_bG[a]) {
                lib439EC7DD_hud_bList[i] = b;
                lib439EC7DD_hud_bList[j] = a;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    t = StringToText("<c val=\"FFD700\">Bounty earned</c>");
    v = StringToText(" ");
    k = 0;
    while (k < lib439EC7DD_hud_bRows) {
        p = lib439EC7DD_hud_bList[k];
        t = t + StringToText("<n/>") + TextWithColor(PlayerName(p), libNtve_gf_ConvertPlayerColorToColor(PlayerGetColorIndex(p, false)));
        TimerWindowSetTitle(lib439EC7DD_hud_twBounty[k + 1], lib439EC7DD_hud_BountyText(p));
        k = k + 1;
    }
    TimerWindowSetTitle(lib439EC7DD_hud_twBounty[0], t);
    TimerWindowSetFormat(lib439EC7DD_hud_twBounty[0], v);
}
// ===== teams =====
void lib439EC7DD_hud_Teams () {
    int p;
    int q;
    p = 1;
    while (p <= 13) {
        lib439EC7DD_hud_team[p] = 0;
        if (lib439EC7DD_hud_IsReal(p)) {
            lib439EC7DD_hud_team[p] = p;
            q = 1;
            while (q < p) {
                if (lib439EC7DD_hud_team[q] == q && PlayerGetAlliance(p, c_allianceIdPassive, q) && PlayerGetAlliance(q, c_allianceIdPassive, p)) {
                    lib439EC7DD_hud_team[p] = q;
                    q = p;
                }
                q = q + 1;
            }
        }
        p = p + 1;
    }
}
text lib439EC7DD_hud_TeamName (int lead) {
    int p;
    text t;
    bool first;
    t = StringToText("");
    first = true;
    p = 1;
    while (p <= 13) {
        if (lib439EC7DD_hud_team[p] == lead && lead != 0) {
            if (!first) { t = t + StringToText(" + "); }
            t = t + TextWithColor(PlayerName(p), libNtve_gf_ConvertPlayerColorToColor(PlayerGetColorIndex(p, false)));
            first = false;
        }
        p = p + 1;
    }
    return t;
}
int lib439EC7DD_hud_TeamSize (int lead) {
    int p;
    int n;
    n = 0;
    p = 1;
    while (p <= 13) {
        if (lib439EC7DD_hud_team[p] == lead && lead != 0) { n = n + 1; }
        p = p + 1;
    }
    return n;
}
// ===== zone priority: 1 ground > 2 cloaked/burrowed ground > 3 air > 4 cloaked air > 5 temporary units > 6 eggs/cocoons =====
bool lib439EC7DD_hud_IsTemp (string t) {
    if (t == "Broodling" || t == "BroodlingEscort" || t == "AutoTurret" || t == "MULE" || t == "Interceptor") { return true; }
    if (t == "AdeptPhaseShift" || t == "DisruptorPhased" || t == "InfestedTerran" || t == "InfestorTerran") { return true; }
    if (StringContains(t, "Locust", c_stringBegin, c_stringNoCase)) { return true; }
    if (StringContains(t, "Changeling", c_stringBegin, c_stringNoCase)) { return true; }
    return false;
}
bool lib439EC7DD_hud_IsEgg (string t) {
    if (t == "Egg" || t == "Larva" || StringContains(t, "Cocoon", c_stringAnywhere, c_stringNoCase) || StringContains(t, "Egg", c_stringEnd, c_stringCase)) { return true; }
    return false;
}
bool lib439EC7DD_hud_Round (bool testConds, bool runActions) {
    unitgroup g;
    unit u;
    unit bestU;
    int n;
    int i;
    int o;
    int tier;
    int best;
    int teams;
    int ctl;
    int p;
    int lead;
    string ty;
    bool[16] at;
    bool[16] present;
    int[128] tiers;
    text msg;
    if (lib439EC7DD_hud_built == false || lib439EC7DD_gv_gameEnded) { return true; }
    // one unit search per tick; each unit's tier is worked out once and reused
    g = UnitGroup(null, c_playerAny, lib439EC7DD_gv_captureZone, UnitFilter(0, 0, (1 << c_targetFilterStructure) | (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)) | (1 << (c_targetFilterHallucination - 32)) | (1 << (c_targetFilterBenign - 32))), 0);
    best = 99;
    bestU = null;
    p = 0;
    while (p <= 15) { at[p] = false; present[p] = false; p = p + 1; }
    n = UnitGroupCount(g, c_unitCountAll);
    if (n > 127) { n = 127; }
    // pass 1: tier of every unit, best tier
    i = 1;
    while (i <= n) {
        u = UnitGroupUnit(g, i);
        o = UnitGetOwner(u);
        tiers[i] = 99;
        if (o >= 1 && o <= 13 && lib439EC7DD_hud_team[o] != 0) {
            present[o] = true;
            ty = UnitGetType(u);
            if (lib439EC7DD_hud_IsEgg(ty)) { tier = 6; }
            else if (lib439EC7DD_hud_IsTemp(ty)) { tier = 5; }
            else if (UnitFilterMatch(u, o, UnitFilter((1 << c_targetFilterAir), 0, 0, 0))) {
                if (UnitFilterMatch(u, o, UnitFilter((1 << c_targetFilterCloaked), 0, 0, 0))) { tier = 4; } else { tier = 3; }
            }
            else {
                if (UnitFilterMatch(u, o, UnitFilter((1 << c_targetFilterCloaked), 0, 0, 0)) || UnitFilterMatch(u, o, UnitFilter((1 << c_targetFilterBuried), 0, 0, 0))) { tier = 2; } else { tier = 1; }
            }
            tiers[i] = tier;
            if (tier < best) { best = tier; }
        }
        i = i + 1;
    }
    // pass 2: teams that have a unit of the best tier
    teams = 0;
    ctl = 0;
    i = 1;
    while (i <= n && best < 99) {
        if (tiers[i] == best) {
            u = UnitGroupUnit(g, i);
            lead = lib439EC7DD_hud_team[UnitGetOwner(u)];
            if (!at[lead]) { at[lead] = true; teams = teams + 1; ctl = lead; bestU = u; }
        }
        i = i + 1;
    }
    if (teams != 1) { ctl = 0; }
    lib439EC7DD_gv_unitsInZone = g;
    lib439EC7DD_gv_playerCount = teams;
    lib439EC7DD_gv_controllingPlayer = ctl;
    // minerals: every member of the controlling team who has units on the circle
    if (ctl != 0) {
        p = 1;
        while (p <= 13) {
