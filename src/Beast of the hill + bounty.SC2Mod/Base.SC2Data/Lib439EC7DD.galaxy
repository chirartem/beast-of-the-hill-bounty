// External Library Initialization
void lib439EC7DD_InitLibraries () {
    libNtve_InitVariables();
}

// Variable Initialization
bool lib439EC7DD_InitVariables_completed = false;

void lib439EC7DD_InitVariables () {
    if (lib439EC7DD_InitVariables_completed) {
        return;
    }

    lib439EC7DD_InitVariables_completed = true;

    lib439EC7DD_gv_searchRadius = 10.0;
    lib439EC7DD_gv_visionRadius = 7.5;
    lib439EC7DD_gv_playersInZone = PlayerGroupEmpty();
    lib439EC7DD_gv_unitsInZone = UnitGroupEmpty();
    lib439EC7DD_gv_mineralsPerSecond = 10;
    lib439EC7DD_gv_round3PlusTime = 180;
    lib439EC7DD_gv_round2Time = 240;
    lib439EC7DD_gv_round1Time = 300;
    lib439EC7DD_gv_captureRadius = 2.25;
    lib439EC7DD_gv_maxRounds = 3;
    lib439EC7DD_gv_bountyPercent = 100;
    lib439EC7DD_gv_currentRound = 1;
}

// Custom Script
//--------------------------------------------------------------------------------------------------
// Custom Script: BountyHUD
//--------------------------------------------------------------------------------------------------
// --- neutral objects near a point that hud_Clear will remove (Xel'Naga towers, rocks, critters...; never minerals / geysers)
unitgroup lib439EC7DD_hud_Neutrals (point c, fixed r) {
    unitgroup g;
    unitgroup res;
    int i;
    int n;
    int o;
    unit u;
    res = UnitGroupEmpty();
    g = UnitGroup(null, c_playerAny, RegionCircle(c, r), null, 0);
    n = UnitGroupCount(g, c_unitCountAll);
    i = 1;
    while (i <= n) {
        u = UnitGroupUnit(g, i);
        o = UnitGetOwner(u);
        if ((o == 0 || o == 15) && !UnitFilterMatch(u, o, UnitFilter((1 << c_targetFilterRawResource), 0, 0, 0))) { UnitGroupAdd(res, u); }
        i = i + 1;
    }
    return res;
}
// true if an unwalkable point is only blocked by one of those removable objects
bool lib439EC7DD_hud_Removable (point p, unitgroup ng) {
    int i;
    int n;
    unit u;
    n = UnitGroupCount(ng, c_unitCountAll);
    i = 1;
    while (i <= n) {
        u = UnitGroupUnit(ng, i);
        if (DistanceBetweenPoints(p, UnitGetPosition(u)) <= UnitGetPropertyFixed(u, c_unitPropRadius, c_unitPropCurrent) + 1.0) { return true; }
        i = i + 1;
    }
    return false;
}
// --- pick a spot for the red circle: whole circle on one cliff level, height spread < 0.4, no hiding grass (shrubs),
// every half cell walkable - except where only a removable neutral object (tower, rocks) stands
bool lib439EC7DD_hud_IsFlat (point c, fixed r) {
    int a;
    int i;
    int j;
    int k;
    fixed h0;
    fixed h;
    point q;
    int lvl;
    unitgroup ng;
    h0 = WorldHeight(c_heightMapGround, c);
    lvl = CliffLevel(c);
    a = 0;
    while (a < 16) {
        q = PointWithOffsetPolar(c, r, IntToFixed(a) * 22.5);
        if (CliffLevel(q) != lvl) { return false; }
        h = WorldHeight(c_heightMapGround, q);
        if (AbsF(h - h0) > 0.4) { return false; }
        q = PointWithOffsetPolar(c, r * 0.5, IntToFixed(a) * 22.5);
        if (CliffLevel(q) != lvl) { return false; }
        h = WorldHeight(c_heightMapGround, q);
        if (AbsF(h - h0) > 0.4) { return false; }
        a = a + 1;
    }
    ng = null;
    k = FixedToInt(r * 2.0);
    i = -k;
    while (i <= k) {
        j = -k;
        while (j <= k) {
            if (i * i + j * j <= k * k) {
                q = PointWithOffset(c, IntToFixed(i) * 0.5, IntToFixed(j) * 0.5);
                if (InShrub(q)) { return false; }
                if (PointPathingPassable(q) == false) { if (ng == null) { ng = lib439EC7DD_hud_Neutrals(c, r + 3.0); } if (!lib439EC7DD_hud_Removable(q, ng)) { return false; } }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return true;
}
// a start location of any active player (kept for possible later use)
point lib439EC7DD_hud_Start () {
    int p;
    p = 1;
    while (p <= 15) {
        if (PlayerStatus(p) == c_playerStatusActive && PlayerStartLocation(p) != null) { return PlayerStartLocation(p); }
        p = p + 1;
    }
    return null;
}
// good spot: see IsFlat; no minerals / geysers and no players' buildings under or next to the circle
bool lib439EC7DD_hud_GoodSpot (point q, fixed r, point s) {
    unitgroup g;
    int i;
    int n;
    int o;
    if (!lib439EC7DD_hud_IsFlat(q, r)) { return false; }
    if (UnitGroupCount(UnitGroup(null, c_playerAny, RegionCircle(q, r + 0.5), UnitFilter((1 << c_targetFilterRawResource), 0, 0, 0), 1), c_unitCountAll) > 0) { return false; }
    g = UnitGroup(null, c_playerAny, RegionCircle(q, r + 0.5), UnitFilter((1 << c_targetFilterStructure), 0, 0, 0), 0);
    n = UnitGroupCount(g, c_unitCountAll);
    i = 1;
    while (i <= n) {
        o = UnitGetOwner(UnitGroupUnit(g, i));
        if (o >= 1 && o <= 14) { return false; }
        i = i + 1;
    }
    return true;
}
// clear the circle: remove neutral objects touching it (Xel'Naga towers, rocks, critters) and decorations standing on it
void lib439EC7DD_hud_Clear (point c, fixed r) {
    unitgroup ng;
    int i;
    int n;
    unit u;
    actor a; revealer[16] rv;
    ng = lib439EC7DD_hud_Neutrals(c, r + 4.0);
    n = UnitGroupCount(ng, c_unitCountAll);
    i = 1;
    while (i <= n) {
        u = UnitGroupUnit(ng, i);
        if (DistanceBetweenPoints(c, UnitGetPosition(u)) <= r + UnitGetPropertyFixed(u, c_unitPropRadius, c_unitPropCurrent) + 0.5) { UnitRemove(u); }
        i = i + 1;
    }
    if (n > 0) { i = 0; while (i <= 15) { rv[i] = VisRevealerCreate(i, RegionCircle(c, r + 4.0)); i = i + 1; } Wait(0.5, c_timeGame); i = 0; while (i <= 15) { VisRevealerDestroy(rv[i]); i = i + 1; } }
    // (above) a 0.5 s reveal so removed objects also vanish from everyone's fog of war, then the vision is taken away again
}
// remove the map's own fog / mist / steam decorations near the circle (only map doodads: unit and ability effects are never touched)
void lib439EC7DD_hud_Unfog (point c, fixed r) {
    string list;
    string t;
    int i;
    actor a;
    list = "XelNaga_PsionicStormCloud Fog_Hazy Fog_Aiur Fog_Aiur_Thick Fog_Shakuras Fog_Shakuras_Thick_Windy Fog_Shakuras_Thick_Windy_Fast Fog_Shakuras_Windy Fog_Shakuras_Windy_Fast Fog_Ulnar FogMistSnow FogMist FogBlue FogGrey FogStormDeep FogStormDeepWhite GasGiantMist Void_Mist TheVoid_DeathCloud_Intense SnowBase_Steam_Thick SnowBase_Steam_Thick_Sm SpaceSteamJet SpacePlatformSteamVent SmokeMedium Smoke_Battle Hybrid01GasCloud Nanocloud_Currents CreepCloud DustStorms WindEnergyDust";
    i = 1;
    t = StringWord(list, i);
    while (t != "") {
        a = ActorRegionCreate(null, "TriggerRegion", RegionCircle(c, r));
        ActorRegionSend(a, c_actorIntersectAgainstRadiusVisual, "Destroy", "Doodad", "ScopeContains " + t + "; !HasStatus DoodadKilled");
        ActorScopeKill(ActorScopeFromActor(a));
        i = i + 1;
        t = StringWord(list, i);
    }
}
// search outward from the map centre in square rings of whole cells (up to 30), nearest good spot wins
point lib439EC7DD_hud_FlatSpot (point c, fixed r) {
    int d;
    int x;
    int y;
    int step;
    int cx;
    int cy;
    point q;
    point s;
    r = lib439EC7DD_gv_captureRadius; // no extra margin: the spot only has to fit the circle itself
    cx = RoundI(PointGetX(c));
    cy = RoundI(PointGetY(c));
    d = 0;
    while (d <= 30) {
        x = -d;
        while (x <= d) {
            if (AbsI(x) == d) { step = 1; } else { step = 2 * d; }
            y = -d;
            while (y <= d) {
                q = Point(IntToFixed(cx + x), IntToFixed(cy + y));
                if (lib439EC7DD_hud_GoodSpot(q, r, s)) { return q; }
                y = y + step;
            }
            x = x + 1;
        }
        d = d + 1;
    }
    return c;
}
