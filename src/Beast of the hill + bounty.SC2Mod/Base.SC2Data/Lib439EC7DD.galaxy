    lib439EC7DD_gv_centerPoint = RegionGetCenter(RegionPlayableMap());
    lib439EC7DD_gv_originalCenterPoint = lib439EC7DD_gv_centerPoint;
    while ((lib439EC7DD_gv_searchAttempts < 20) && (lib439EC7DD_gv_zoneIsClear == false)) {
