}
// --- lobby option 8 "Starting workers": value 2 = classic 12 workers (+4) ---
void lib439EC7DD_hud_SetFood (string u, string v) {
    int p;
    p = 0;
    while (p <= 15) {
        CatalogFieldValueSet(c_gameCatalogUnit, u, "Food", p, v);
        p = p + 1;
    }
}
// ring of 24 spots around the town hall, in the same order as the race Starting Units offsets
void lib439EC7DD_hud_Ring () {
    int k;
    k = 0;
    // (0,-3)..(3,-3), (3,-2)..(3,3), (2,3)..(-3,3), (-3,2)..(-3,-3), (-2,-3),(-1,-3)
    while (k < 24) {
        if (k <= 3) { lib439EC7DD_hud_rx[k] = k; lib439EC7DD_hud_ry[k] = -3; }
        else if (k <= 9) { lib439EC7DD_hud_rx[k] = 3; lib439EC7DD_hud_ry[k] = k - 6; }
        else if (k <= 15) { lib439EC7DD_hud_rx[k] = 12 - k; lib439EC7DD_hud_ry[k] = 3; }
        else if (k <= 21) { lib439EC7DD_hud_rx[k] = -3; lib439EC7DD_hud_ry[k] = 18 - k; }
        else { lib439EC7DD_hud_rx[k] = k - 24; lib439EC7DD_hud_ry[k] = -3; }
        k = k + 1;
    }
}
bool lib439EC7DD_hud_IsCorner (int k) {
    int i;
    i = ModI(k + 24, 24);
    return (AbsI(lib439EC7DD_hud_rx[i]) == 3 && AbsI(lib439EC7DD_hud_ry[i]) == 3);
}
bool lib439EC7DD_hud_Workers (bool testConds, bool runActions) {
    int p;
    int i;
    int k;
    int n;
    int a;
    int b;
    int dir;
    int placed;
    int cur;
    string race;
    string w;
    string ab;
    unit hall;
    unit best;
    unit u;
    unitgroup g;
    unitgroup made;
    unitgroup ws;
    point hp;
    point q;
    fixed d;
    fixed bd;
    bool[25] occ;
    bool any;
    if (StringToInt(GameAttributeGameValue("8")) != 2) { return true; }
    // classic supply: CC / Nexus 15, Hatchery 6 (and their upgrades)
    lib439EC7DD_hud_SetFood("CommandCenter", "15");
    lib439EC7DD_hud_SetFood("CommandCenterFlying", "15");
    lib439EC7DD_hud_SetFood("OrbitalCommand", "15");
    lib439EC7DD_hud_SetFood("OrbitalCommandFlying", "15");
    lib439EC7DD_hud_SetFood("PlanetaryFortress", "15");
    lib439EC7DD_hud_SetFood("Nexus", "15");
    lib439EC7DD_hud_SetFood("Hatchery", "6");
    lib439EC7DD_hud_SetFood("Lair", "6");
    lib439EC7DD_hud_SetFood("Hive", "6");
    lib439EC7DD_hud_Ring();
    Wait(0.0625, c_timeGame);
    p = 1;
    while (p <= 13) {
        if (PlayerStatus(p) == c_playerStatusActive) {
            race = PlayerRace(p);
            w = "";
            if (race == "Terr") { w = "SCV"; ab = "SCVHarvest"; }
            if (race == "Prot") { w = "Probe"; ab = "ProbeHarvest"; }
            if (race == "Zerg") { w = "Drone"; ab = "DroneHarvest"; }
            g = UnitGroup(null, p, RegionEntireMap(), UnitFilter((1 << c_targetFilterStructure), 0, 0, 0), 0);
            if (w != "" && UnitGroupCount(g, c_unitCountAlive) > 0) {
                hall = UnitGroupUnit(g, 1);
                hp = UnitGetPosition(hall);
                // which ring spots already hold a starting worker
                ws = UnitGroup(w, p, RegionCircle(hp, 6.0), null, 0);
                any = false;
                k = 0;
                while (k < 24) {
                    occ[k] = false;
                    q = PointWithOffset(hp, IntToFixed(lib439EC7DD_hud_rx[k]), IntToFixed(lib439EC7DD_hud_ry[k]));
                    n = UnitGroupCount(ws, c_unitCountAll);
                    i = 1;
                    while (i <= n) {
                        if (DistanceBetweenPoints(q, UnitGetPosition(UnitGroupUnit(ws, i))) < 0.9) { occ[k] = true; any = true; }
                        i = i + 1;
                    }
                    k = k + 1;
                }
                made = UnitGroupEmpty();
                if (any) {
                    // find the ends of the occupied arc: a = first occupied after a free spot, b = last occupied before a free spot
                    a = -1;
                    b = -1;
                    k = 0;
                    while (k < 24) {
                        if (occ[k] && !occ[ModI(k + 23, 24)]) { a = k; }
                        if (occ[k] && !occ[ModI(k + 1, 24)]) { b = k; }
                        k = k + 1;
                    }
                    // continue from the end that has already turned a corner (keeps the L-shaped line going)
                    dir = 1;
                    if (a >= 0 && lib439EC7DD_hud_IsCorner(a + 1) && !lib439EC7DD_hud_IsCorner(b - 1)) { dir = -1; }
                    if (dir == 1) { cur = b; } else { cur = a; }
                    placed = 0;
                    k = 0;
                    while (placed < 4 && k < 24) {
                        cur = ModI(cur + dir + 24, 24);
                        if (!occ[cur]) {
                            q = PointWithOffset(hp, IntToFixed(lib439EC7DD_hud_rx[cur]), IntToFixed(lib439EC7DD_hud_ry[cur]));
                            UnitCreate(1, w, c_unitCreateIgnorePlacement, p, q, AngleBetweenPoints(q, hp));
                            UnitGroupAdd(made, UnitLastCreated());
                            occ[cur] = true;
                            placed = placed + 1;
                        }
                        k = k + 1;
                    }
                }
                else {
                    UnitCreate(4, w, 0, p, hp, 270.0);
                    made = UnitLastCreatedGroup();
                }
                g = UnitGroup(null, c_playerAny, RegionCircle(hp, 15.0), null, 0);
                best = null;
                bd = 999.0;
                n = UnitGroupCount(g, c_unitCountAll);
                i = 1;
                while (i <= n) {
                    u = UnitGroupUnit(g, i);
                    if (StringContains(UnitGetType(u), "MineralField", c_stringAnywhere, c_stringNoCase)) {
                        d = DistanceBetweenPoints(hp, UnitGetPosition(u));
                        if (d < bd) { bd = d; best = u; }
                    }
                    i = i + 1;
                }
                if (best != null) {
                    n = UnitGroupCount(made, c_unitCountAll);
                    i = 1;
                    while (i <= n) {
                        UnitIssueOrder(UnitGroupUnit(made, i), OrderTargetingUnit(AbilityCommand(ab, 0), best), c_orderQueueReplace);
                        i = i + 1;
                    }
                }
            }
        }
        p = p + 1;
    }
    return true;
}
// --- no building on the red circle: cancel any build / land order aimed at it ---
bool lib439EC7DD_hud_BuildBlock (bool testConds, bool runActions) {
    order o;
    string ab;
    unit u;
    o = EventUnitOrder();
    if (OrderGetTargetType(o) != c_orderTargetPoint) { return true; }
    ab = AbilityCommandGetAbility(OrderGetAbilityCommand(o));
    if (!StringContains(ab, "Build", c_stringAnywhere, c_stringNoCase) && !StringContains(ab, "Land", c_stringAnywhere, c_stringNoCase)) { return true; }
    if (DistanceBetweenPoints(OrderGetTargetPoint(o), lib439EC7DD_gv_centerPoint) > lib439EC7DD_gv_captureRadius + 2.0) { return true; }
    u = EventUnit();
    UnitIssueOrder(u, Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
    UIDisplayMessage(PlayerGroupSingle(UnitGetOwner(u)), c_messageAreaError, StringToText("You can't build on the red circle!"));
    return true;
}
// --- red circle: carried by an invisible dummy unit, so nearby buildings can't remove it ---
bool lib439EC7DD_hud_Circle (bool testConds, bool runActions) {
    int p;
    Wait(0.0625, c_timeGame);
    // owned by hostile player 15, whose vision is shared with everyone, so the circle shows through fog (the dummy has no sight radius)
        // snap to whole cells so the 6x6 no-build footprint (unit CZNoBuildCircle) sits centred under the circle
    lib439EC7DD_gv_centerPoint = Point(IntToFixed(RoundI(PointGetX(lib439EC7DD_gv_centerPoint))), IntToFixed(RoundI(PointGetY(lib439EC7DD_gv_centerPoint))));
    lib439EC7DD_gv_captureZone = RegionCircle(lib439EC7DD_gv_centerPoint, lib439EC7DD_gv_captureRadius);
    lib439EC7DD_hud_Clear(lib439EC7DD_gv_centerPoint, lib439EC7DD_gv_captureRadius);
    lib439EC7DD_hud_Unfog(lib439EC7DD_gv_centerPoint, lib439EC7DD_gv_captureRadius + 1.0);
    UnitCreate(1, "InvisibleTargetDummy2", 0, 15, lib439EC7DD_gv_centerPoint, 270.0);
    UnitSetPosition(UnitLastCreated(), lib439EC7DD_gv_centerPoint, false);
                p = 0;
    while (p <= 14) { PlayerSetAlliance(15, c_allianceIdVision, p, true); p = p + 1; }
    return true;
}
// --- observers: the mod's GameUI data sets DefaultObservedPlayerId = 14, so observers in "Everyone" view see what player 14 sees.
// Every player shares vision with 14 so observers still see the whole game; UI shown only to 14 is observers-only.
bool lib439EC7DD_hud_Observer (bool testConds, bool runActions) {
    int p;
    p = 0;
    while (p <= 13) {
        PlayerSetAlliance(p, c_allianceIdVision, 14, true);
        PlayerSetAlliance(p, c_allianceIdPassive, 14, true);
        PlayerSetAlliance(p, c_allianceIdControl, 14, true);
        PlayerSetAlliance(p, c_allianceIdDefeat, 14, true);
        libNtve_gf_SetAllianceOneWay(14, p, libNtve_ge_AllianceSetting_Neutral);
        p = p + 1;
    }
    return true;
}
// --- a structure started on the red circle anyway (order not intercepted): remove it and give everything back
bool lib439EC7DD_hud_NoBuild (bool testConds, bool runActions) {
    unit u;
    int o;
    string ty;
    fixed r;
    u = EventUnitProgressUnit(); if (u == null || !UnitFilterMatch(u, UnitGetOwner(u), UnitFilter((1 << c_targetFilterStructure), 0, 0, 0))) { u = EventUnit(); }
    o = UnitGetOwner(u);
    if (o < 1 || o > 13) { return true; }
    if (!UnitFilterMatch(u, o, UnitFilter((1 << c_targetFilterStructure), 0, 0, 0))) { return true; }
    r = UnitGetPropertyFixed(u, c_unitPropRadius, c_unitPropCurrent);
    if (DistanceBetweenPoints(UnitGetPosition(u), lib439EC7DD_gv_centerPoint) > lib439EC7DD_gv_captureRadius + r * 1.4) { return true; }
    ty = UnitGetType(u);
    PlayerModifyPropertyInt(o, c_playerPropMinerals, c_playerPropOperAdd, UnitTypeGetCost(ty, c_unitCostMinerals));
    PlayerModifyPropertyInt(o, c_playerPropVespene, c_playerPropOperAdd, UnitTypeGetCost(ty, c_unitCostVespene));
    // a Zerg drone turned into the building: give the drone back too
    if (PlayerRace(o) == "Zerg" && !StringContains(ty, "CreepTumor", c_stringAnywhere, c_stringNoCase) && !StringContains(ty, "Nydus", c_stringAnywhere, c_stringNoCase)) {
        UnitCreate(1, "Drone", c_unitCreateIgnorePlacement, o, UnitGetPosition(u), 270.0);
    }
    UnitRemove(u);
    UIDisplayMessage(PlayerGroupSingle(o), c_messageAreaError, StringToText("You can't build on the red circle!"));
    return true;
}
// --- a player left the game: drop them from the score and bounty tables
bool lib439EC7DD_hud_Left (bool testConds, bool runActions) {
    int p;
    int q;
    int lead;
    int nl;
    int k;
    p = EventPlayer();
    if (p < 1 || p > 15 || lib439EC7DD_hud_built == false) { return true; }
    // score: remove from the team; if the team's lead left, the next member becomes the lead (same points)
    lead = lib439EC7DD_hud_team[p];
    if (lead != 0) {
        lib439EC7DD_hud_team[p] = 0;
        lib439EC7DD_hud_hasRow[p] = false;
        if (lead == p) {
            nl = 0;
            q = 1;
            while (q <= 13) {
                if (lib439EC7DD_hud_team[q] == p) {
                    if (nl == 0) { nl = q; }
                    lib439EC7DD_hud_team[q] = nl;
                }
                q = q + 1;
            }
            if (nl != 0) {
                lib439EC7DD_hud_hasRow[nl] = true;
                lib439EC7DD_hud_shownScore[nl] = lib439EC7DD_gv_playerScore[nl];
            }
        }
        lib439EC7DD_hud_ScoreRefresh();
    }
    // bounty: remove the row, hide the last value window, re-anchor the first one to the shorter list
    k = 0;
    while (k < lib439EC7DD_hud_bRows) {
        if (lib439EC7DD_hud_bList[k] == p) { break; }
        k = k + 1;
    }
    if (k < lib439EC7DD_hud_bRows) {
        while (k < lib439EC7DD_hud_bRows - 1) {
            lib439EC7DD_hud_bList[k] = lib439EC7DD_hud_bList[k + 1];
            k = k + 1;
        }
        TimerWindowShow(lib439EC7DD_hud_twBounty[lib439EC7DD_hud_bRows], lib439EC7DD_hud_G(), false);
        lib439EC7DD_hud_bRows = lib439EC7DD_hud_bRows - 1;
        if (lib439EC7DD_hud_bRows > 0) {
            TimerWindowSetAnchor(lib439EC7DD_hud_twBounty[1], c_anchorTopRight, lib439EC7DD_hud_bOffX, lib439EC7DD_hud_bOff1 - lib439EC7DD_hud_bOffRow * lib439EC7DD_hud_bRows);
        }
        else {
            TimerWindowShow(lib439EC7DD_hud_twBounty[0], lib439EC7DD_hud_G(), false);
        }
        lib439EC7DD_hud_BountyRefresh();
    }
    return true;
}
void lib439EC7DD_hud_Init () {
    trigger t;
    t = TriggerCreate("lib439EC7DD_hud_Circle");
    TriggerAddEventMapInit(t);
    lib439EC7DD_hud_fadeTrig = TriggerCreate("lib439EC7DD_hud_Fade");
    t = TriggerCreate("lib439EC7DD_hud_Build");
