    }
    lib439EC7DD_gv_roundTimeRemaining = lib439EC7DD_gv_roundTimeRemaining - 1;
    if (lib439EC7DD_gv_roundTimeRemaining > 0) { return true; }
    lib439EC7DD_gv_roundTimeRemaining = 0;
    // overtime: several teams on top priority -> wait until one remains
    if (teams > 1) {
        if (!lib439EC7DD_hud_contested) {
            lib439EC7DD_hud_contested = true;
            UIDisplayMessage(lib439EC7DD_hud_G(), c_messageAreaChat, StringToText("The point is contested!"));
        }
        return true;
    }
    lib439EC7DD_hud_contested = false;
    if (ctl == 0) {
        msg = StringToText("No players were in the zone! No one wins this round!");
    }
    else {
        p = 1;
        while (p <= 13) {
            if (lib439EC7DD_hud_team[p] == ctl) { lib439EC7DD_gv_playerScore[p] = lib439EC7DD_gv_playerScore[p] + 1; }
            p = p + 1;
        }
        msg = lib439EC7DD_hud_TeamName(ctl);
        if (bestU != null) {
            msg = msg + StringToText(" wins the round with ") + UnitTypeGetName(UnitGetType(bestU)) + StringToText("!");
        }
        else {
            msg = msg + StringToText(" wins the round!");
        }
        msg = msg + StringToText(" Has " + IntToString(lib439EC7DD_gv_playerScore[ctl]) + " point(s) out of " + IntToString(lib439EC7DD_gv_maxRounds) + "!");
    }
    UIDisplayMessage(lib439EC7DD_hud_G(), c_messageAreaChat, msg);
    lib439EC7DD_gv_currentRound = lib439EC7DD_gv_currentRound + 1;
    if (lib439EC7DD_gv_currentRound == 2) { lib439EC7DD_gv_roundTimeRemaining = lib439EC7DD_gv_round2Time; }
    else if (lib439EC7DD_gv_currentRound >= 3) { lib439EC7DD_gv_roundTimeRemaining = lib439EC7DD_gv_round3PlusTime; }
    else { lib439EC7DD_gv_roundTimeRemaining = lib439EC7DD_gv_round1Time; }
    lib439EC7DD_hud_lastWarn = -1;
    // victory: the whole team wins, everyone else loses
    if (ctl != 0 && lib439EC7DD_gv_playerScore[ctl] >= lib439EC7DD_gv_maxRounds) {
        lib439EC7DD_gv_gameEnded = true;
        p = 1;
        while (p <= 13) {
            if (PlayerStatus(p) == c_playerStatusActive && lib439EC7DD_hud_team[p] != 0 && lib439EC7DD_hud_team[p] != ctl) { GameOver(p, c_gameOverDefeat, true, true); }
            p = p + 1;
        }
        p = 1;
        while (p <= 13) {
            if (PlayerStatus(p) == c_playerStatusActive && lib439EC7DD_hud_team[p] == ctl) { GameOver(p, c_gameOverVictory, true, true); }
            p = p + 1;
        }
    }
    return true;
}
