    if (lib439EC7DD_hud_built == false) {
        return true;
    }
    t = lib439EC7DD_gv_roundTimeRemaining;
    if (t < 0) {
        t = 0;
    }
    if (t != lib439EC7DD_hud_lastWarn && (t == 120 || t == 60 || t == 30 || t == 20 || t == 10 || t == 5)) {
        lib439EC7DD_hud_lastWarn = t;
        lib439EC7DD_hud_Warn(t);
    }
    if (t != lib439EC7DD_hud_lastT) {
        lib439EC7DD_hud_lastT = t;
        TimerWindowSetFormat(lib439EC7DD_hud_twTimer, TextTimeFormat(StringToText("<min2/>:<sec2/>"), t));
    }
    p = 1;
    while (p <= 13) {
        if (lib439EC7DD_hud_hasRow[p] == true && lib439EC7DD_gv_playerScore[p] != lib439EC7DD_hud_shownScore[p]) {
            lib439EC7DD_hud_shownScore[p] = lib439EC7DD_gv_playerScore[p];
            lib439EC7DD_hud_ScoreRefresh();
        }
        p = p + 1;
    }
    if (lib439EC7DD_hud_bDirty) {
        lib439EC7DD_hud_bDirty = false;
        lib439EC7DD_hud_BountyRefresh();
    }
    return true;
}
bool lib439EC7DD_hud_Click (bool testConds, bool runActions) {
    int p;
    int c;
    p = EventPlayer();
    c = EventDialogControl();
    if (p < 0 || p > 15) { return true; }
    // rules panel and score table toggle per player
    if (c == lib439EC7DD_hud_helpBtn) {
        lib439EC7DD_hud_infoShown[p] = !lib439EC7DD_hud_infoShown[p];
        DialogControlSetVisible(lib439EC7DD_hud_infoDlg, PlayerGroupSingle(p), lib439EC7DD_hud_infoShown[p]);
    }
    if (c == lib439EC7DD_hud_scoreBtn) {
        lib439EC7DD_hud_scoreShown[p] = !lib439EC7DD_hud_scoreShown[p];
        TimerWindowShow(lib439EC7DD_hud_twScore[0], PlayerGroupSingle(p), lib439EC7DD_hud_scoreShown[p]);
    }
