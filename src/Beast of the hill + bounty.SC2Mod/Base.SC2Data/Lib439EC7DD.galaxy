}
text lib439EC7DD_hud_TeamName (int lead);
// score table: one timer window, names in the title column, points in the time column
void lib439EC7DD_hud_ScoreRefresh () {
    int p;
    int i;
    int j;
    int k;
    int n;
    int[14] ord;
    text t;
    text v;
    // teams sorted by points, most first (ties keep player order)
    n = 0;
    p = 1;
    while (p <= 13) {
        if (lib439EC7DD_hud_team[p] == p) { ord[n] = p; n = n + 1; }
        p = p + 1;
    }
    i = 1;
    while (i < n) {
        k = ord[i];
        j = i - 1;
        while (j >= 0) {
            if (lib439EC7DD_gv_playerScore[ord[j]] >= lib439EC7DD_gv_playerScore[k]) { break; }
            ord[j + 1] = ord[j];
            j = j - 1;
        }
        ord[j + 1] = k;
        i = i + 1;
    }
    t = StringToText("<c val=\"FFD700\">Score</c>");
    v = StringToText(" ");
    i = 0;
    while (i < n) {
        p = ord[i];
        t = t + StringToText("<n/>") + lib439EC7DD_hud_TeamName(p);
        v = v + StringToText("<n/>") + IntToText(lib439EC7DD_gv_playerScore[p]);
        i = i + 1;
    }
    TimerWindowSetTitle(lib439EC7DD_hud_twScore[0], t);
    TimerWindowSetFormat(lib439EC7DD_hud_twScore[0], v);
}
text lib439EC7DD_hud_BountyText (int p) {
