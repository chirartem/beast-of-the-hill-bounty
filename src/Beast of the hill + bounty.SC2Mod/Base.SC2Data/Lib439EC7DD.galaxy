// every slot 0..15 (incl. neutral 0) -- used for all HUD visibility, so spectators get it wherever SC2 allows
playergroup lib439EC7DD_hud_grp;
playergroup lib439EC7DD_hud_G () {
    int p;
    if (lib439EC7DD_hud_grp == null) {
        lib439EC7DD_hud_grp = PlayerGroupEmpty();
        p = 0;
        while (p <= 15) {
            PlayerGroupAdd(lib439EC7DD_hud_grp, p);
            p = p + 1;
        }
    }
    return lib439EC7DD_hud_grp;
}
// HUD boxes live inside the game UI (not trigger dialogs) so observers / referees see them too
int lib439EC7DD_hud_root;
int lib439EC7DD_hud_Box (int w, int h, int anchor, int x, int y) {
    int p;
    int img;
    if (lib439EC7DD_hud_root == 0) {
        lib439EC7DD_hud_root = DialogControlHookupStandard(c_triggerControlTypePanel, "UIContainer/FullscreenUpperContainer");
    }
    p = DialogControlCreateInPanel(lib439EC7DD_hud_root, c_triggerControlTypePanel);
    DialogControlSetObservedType(p, c_triggerObservedTypeObservedOrSelectedPlayerId);
    DialogControlSetSize(p, lib439EC7DD_hud_G(), w, h);
    DialogControlSetPosition(p, lib439EC7DD_hud_G(), anchor, x, y);
    img = DialogControlCreateInPanel(p, c_triggerControlTypeImage);
    DialogControlSetObservedType(img, c_triggerObservedTypeObservedOrSelectedPlayerId);
    DialogControlSetSize(img, lib439EC7DD_hud_G(), w, h);
    DialogControlSetPosition(img, lib439EC7DD_hud_G(), c_anchorTopLeft, 0, 0);
    DialogControlSetPropertyAsString(img, c_triggerControlPropertyImage, lib439EC7DD_hud_G(), "@@UI/TriggerDialogFrameBackground");
    DialogControlSetPropertyAsInt(img, c_triggerControlPropertyImageType, lib439EC7DD_hud_G(), c_triggerImageTypeBorder);
    return p;
}
int lib439EC7DD_hud_TW (text title) {
    int w;
