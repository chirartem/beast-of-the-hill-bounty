        }

        if ((PointPathingPassable(PointWithOffsetPolar(lib439EC7DD_gv_centerPoint, lib439EC7DD_gv_captureRadius, 270.0)) == false)) {
            lib439EC7DD_gv_zoneIsClear = false;
        }

        lib439EC7DD_gv_centerPoint = lib439EC7DD_hud_FlatSpot(lib439EC7DD_gv_originalCenterPoint, lib439EC7DD_gv_captureRadius + 0.75); lib439EC7DD_gv_zoneIsClear = true;
        lib439EC7DD_gv_searchAttempts = (lib439EC7DD_gv_searchAttempts + 1);
    }
    lib439EC7DD_gv_captureZone = RegionCircle(lib439EC7DD_gv_centerPoint, lib439EC7DD_gv_captureRadius);
    PlayerCreateEffectPoint(15, "CZCirclePersistent", lib439EC7DD_gv_centerPoint);
    if ((GameAttributeGameValue("7") == "0001")) {
