void lib439EC7DD_hud_Warn (int t) {
    text msg;
    if (t == 120) { msg = StringToText("Next round in 2 minutes!"); }
    else if (t == 60) { msg = StringToText("Next round in 1 minute!"); }
    else { msg = StringToText("Next round in " + IntToString(t) + " seconds!"); }
    UIDisplayMessage(lib439EC7DD_hud_G(), c_messageAreaDirective, msg);
    // observers keep directive messages on screen, so clear it for everyone after a few seconds
    lib439EC7DD_hud_warnId = lib439EC7DD_hud_warnId + 1;
    TriggerExecute(lib439EC7DD_hud_fadeTrig, true, false);
    if (t == 120 || t == 60 || t == 30 || t == 10) {
        PingCreate(lib439EC7DD_hud_G(), "PingSimple", lib439EC7DD_gv_centerPoint, Color(100.0, 50.0, 0.0), 4.0);
        PingSetObserver(PingLastCreated(), true);
    }
}
bool lib439EC7DD_hud_Fade (bool testConds, bool runActions) {
