//--------------------------------------------------------------------------------------------------
bool lib439EC7DD_gt_BountyOnDeath_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((libNtve_gf_KillingPlayer() <= 15))) {
            return false;
        }

        if (!((UnitFilterMatch(EventUnit(), 0, UnitFilter(0, 0, (1 << c_targetFilterStructure) | (1 << c_targetFilterMissile), (1 << (c_targetFilterHidden - 32)) | (1 << (c_targetFilterHallucination - 32)))) == true))) {
            return false;
        }

        if (!((PlayerStatus(UnitGetOwner(EventUnit())) == c_playerStatusActive))) {
            return false;
        }

        if (!((libNtve_gf_KillingPlayer() != 0))) {
            return false;
        }

        if (!((libNtve_gf_KillingPlayer() != UnitGetOwner(EventUnit())))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    lib439EC7DD_gv_killingPlayer = libNtve_gf_KillingPlayer();
    lib439EC7DD_gv_bountyMinerals = ((UnitTypeGetCost(UnitGetType(EventUnit()), c_unitCostMinerals) * lib439EC7DD_gv_bountyPercent) / 100);
    lib439EC7DD_gv_bountyVespene = ((UnitTypeGetCost(UnitGetType(EventUnit()), c_unitCostVespene) * lib439EC7DD_gv_bountyPercent) / 100);
    PlayerModifyPropertyInt(libNtve_gf_KillingPlayer(), c_playerPropMinerals, c_playerPropOperAdd, lib439EC7DD_gv_bountyMinerals);
    PlayerModifyPropertyInt(libNtve_gf_KillingPlayer(), c_playerPropVespene, c_playerPropOperAdd, lib439EC7DD_gv_bountyVespene);
    lib439EC7DD_hud_AddBounty(lib439EC7DD_gv_killingPlayer, lib439EC7DD_gv_bountyMinerals, lib439EC7DD_gv_bountyVespene);
    return true;
}

